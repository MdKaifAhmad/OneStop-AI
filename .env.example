# ==============================================================
# OneStop Environment Configuration
# ==============================================================

# MongoDB
MONGO_URI=mongodb://localhost:27017/onestopdb

# Express Backend
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-this-with-a-long-random-secret-value-at-least-32-characters
JWT_EXPIRES_IN=7d

# Groq Cloud LLM API Key (Get at: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# FastAPI AI Service
AI_SERVICE_URL=http://localhost:8000
